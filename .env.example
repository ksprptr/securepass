# Public origin of the app — the single source of truth for canonical / OpenGraph /
# robots / sitemap URLs, and the switch that enables the HSTS header (https only).
#
# It is baked in at BUILD time (the SEO routes are statically prerendered), so pass it as
# a Docker build arg. Keep the runtime value identical; request headers such as
# X-Forwarded-Host are deliberately NOT trusted.
APP_URL=http://localhost:3000

# Host port the container publishes on, bound to 127.0.0.1 (docker compose only).
APP_PORT=3000
